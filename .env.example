# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database Configuration (Render PostgreSQL DATABASE_URL or MySQL)
# DATABASE_URL=postgres://user:password@host:port/dbname
DB_NAME=chanda_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Email SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SBVM Youth Association <your_email@gmail.com>

# Notification Channel ('sms', 'email', 'whatsapp', or 'email,whatsapp')
NOTIFICATION_CHANNEL=email,whatsapp
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio WhatsApp Gateway Settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


